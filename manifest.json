{
  "manifest_version": 3,
  "name": "Toledo Organizer",
  "version": "0.7.0",
  "description": "Organize your KU Leuven Toledo courses into your own groups, merge academic years and pick a default version per course.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://toledo.kuleuven.be/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://toledo.kuleuven.be/*"],
      "js": [
        "src/i18n.js",
        "src/storage.js",
        "src/detector.js",
        "src/matcher.js",
        "src/ui.js",
        "src/dashboard.js",
        "src/content.js"
      ],
      "css": ["styles/toledo-theme.css", "styles/organizer.css"],
      "run_at": "document_end"
    }
  ]
}
